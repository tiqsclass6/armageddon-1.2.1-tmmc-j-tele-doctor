##############################################################
# Amazon Linux 2023 AMIs per region
##############################################################

data "aws_ami" "al2023_new_york" {
  provider    = aws.new_york
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

