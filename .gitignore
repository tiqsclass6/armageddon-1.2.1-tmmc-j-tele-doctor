crash.*.log

# Local variable and backend configuration files may contain
# account-specific values or secrets. Commit only examples.
*.tfvars
*.tfvars.json
backend.hcl

!*.tfvars.example
!backend.hcl.example

# Terraform plans and generated reports
*.tfplan
*.plan
tfplan

# Local Terraform CLI configuration
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc

# Keep the dependency lock file in Git.
!.terraform.lock.hcl

